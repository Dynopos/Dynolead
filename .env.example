APP_NAME="Dyno Lead"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_URL=https://dynoleads.example

APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ms_MY

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dynolead
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Mesti lebih besar daripada --timeout queue worker (job AI boleh ambil masa beberapa minit)
DB_QUEUE_RETRY_AFTER=900

CACHE_STORE=database
CACHE_PREFIX=

# E-mel (reset kata laluan, notis langganan). Guna SMTP sebenar di produksi.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Penjual perkhidmatan (Terma, Privasi, invois) ---
COMPANY_NAME="DynoPOS Technologies"
COMPANY_REGISTRATION=
COMPANY_EMAIL=
COMPANY_ADDRESS="Pasir Mas, Kelantan"
COMPANY_WHATSAPP=0182889932

# --- Bayaran CHIP (Fasa 2) ---
CHIP_SECRET_KEY=
CHIP_BRAND_ID=

# Model bayaran: percubaan (lead / hari), yuran aktif sekali, caj ikut guna (kos + markup %)
TRIAL_LEADS=20
TRIAL_DAYS=14
ACTIVATION_FEE_MYR=23.90
USAGE_MARKUP_PERCENT=20
BILL_PLACES_COST=true

# --- Dyno Lead (spec §9.1) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL_SCORE=claude-haiku-4-5-20251001
CLAUDE_MODEL_WRITE=claude-sonnet-5-5
CLAUDE_USE_BATCH=false
CLAUDE_WEB_SEARCH=false
AI_MONTHLY_BUDGET_MYR=100
GOOGLE_PLACES_API_KEY=
PLACES_CACHE_HOURS=24
PRICE_TABLE_PATH=config/ai_prices.php

# Pilihan: tahap "effort" Claude (kosongkan untuk model yang tidak sokong, contoh Haiku 4.5)
CLAUDE_EFFORT_SCORE=
CLAUDE_EFFORT_WRITE=low
